{
  // 매일 영단어 — AI 중계기. 자세한 설명은 src/index.js 머리말 참고.
  "name": "engword-ai-proxy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  // 활성 배포가 있어야 다른 워커가 이 Durable Object 를 부를 수 있어서 켜 둔다.
  // (주소로 들어오는 요청은 src/index.js 의 기본 핸들러가 전부 404 로 막는다)
  "workers_dev": true,
  "preview_urls": false,

  // 자기 자신도 이 클래스를 바인딩해 둬야 네임스페이스가 만들어진다.
  "durable_objects": {
    "bindings": [
      { "name": "AI_PROXY", "class_name": "AIProxy" }
    ]
  },

  // 무료 플랜에서는 SQLite 백엔드 Durable Object 만 쓸 수 있다.
  // (이 객체는 저장을 전혀 하지 않지만, 클래스 등록에는 필요하다)
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AIProxy"] }
  ]
}
