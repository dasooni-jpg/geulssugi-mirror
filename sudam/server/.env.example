# ── 수담(數談) v2 교사 서버 설정 ────────────────────────
# 이 파일을 복사하여 ".env" 로 저장한 뒤 값을 채우세요.
# 이 파일이 없어도 서버는 기본값으로 동작합니다.
# .env 는 절대 GitHub 등에 올리지 마세요(.gitignore 에 등록되어 있음).

# 교실 코드 4자리 — 학생 화면 ⚙설정의 코드와 같아야 함 (외부 오남용 차단)
CLASS_CODE=0000

# 서버 포트
PORT=3000

# ── AI 반례 카드 (선택) ────────────────────────────────
# 넣지 않아도 토론 기능은 모두 동작합니다.
# 없을 때는 발문 은행에 준비된 반례 카드를 씁니다.
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 사용 모델 (기본: gemini-flash-lite-latest)
GEMINI_MODEL=gemini-flash-lite-latest

# (선택) Cloudflare AI Gateway 경유 — 일부 네트워크에서 Gemini 가
# "User location is not supported" 로 막을 때만 설정
# CF_AIG_ACCOUNT_ID=
# CF_AIG_GATEWAY=
